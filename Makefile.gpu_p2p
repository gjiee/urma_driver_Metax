# SPDX-License-Identifier: GPL-2.0+
# Build nvidia.ko + udma.ko with GPU P2P Scheme-A support.
#
# Prerequisites:
#   - Full OLK/UB kernel tree with urma_driver under drivers/ub/
#   - nv_module_netlab checked out as sibling (override NV_REPO)
#
# Usage:
#   make -f Makefile.gpu_p2p KERNEL_SRC=/path/to/kernel \
#        NV_REPO=/path/to/nv_module_netlab modules
#   make -f Makefile.gpu_p2p install

KERNEL_SRC ?= /lib/modules/$(shell uname -r)/build
UB_SRC     ?= $(abspath .)
NV_REPO    ?= $(abspath ../nv_module_netlab)
NV_KO_DIR  ?= $(NV_REPO)/kernel-open
NV_SYMVERS ?= $(NV_KO_DIR)/nvidia/Module.symvers

.PHONY: all modules nvidia udma install clean

all: modules

modules: nvidia udma

nvidia:
	$(MAKE) -C $(NV_KO_DIR) modules

udma: nvidia
	$(MAKE) -C $(KERNEL_SRC) M=$(KERNEL_SRC)/drivers/ub \
		CONFIG_UB=m CONFIG_UB_UDMA=m \
		CONFIG_UB_UDMA_NV_P2P=y CONFIG_UB_UDMA_GPU_P2P_DEBUG=y \
		NV_P2P_HEADER_PATH=$(NV_KO_DIR)/nvidia \
		NV_MODULE_SYMVERS=$(NV_SYMVERS) \
		modules

install: modules
	$(MAKE) -C $(NV_KO_DIR) modules_install
	$(MAKE) -C $(KERNEL_SRC) M=$(KERNEL_SRC)/drivers/ub \
		CONFIG_UB=m CONFIG_UB_UDMA=m \
		CONFIG_UB_UDMA_NV_P2P=y CONFIG_UB_UDMA_GPU_P2P_DEBUG=y \
		NV_P2P_HEADER_PATH=$(NV_KO_DIR)/nvidia \
		NV_MODULE_SYMVERS=$(NV_SYMVERS) \
		modules_install

clean:
	$(MAKE) -C $(NV_KO_DIR) clean
	$(MAKE) -C $(KERNEL_SRC) M=$(KERNEL_SRC)/drivers/ub clean
