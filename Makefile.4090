ifeq ($(KERNELRELEASE),)

KDIR ?= /lib/modules/$(shell uname -r)/build

# NVIDIA Open GPU Kernel Modules
NVIDIA_OPEN_ROOT ?= /home/tong/project_4090/open-gpu-kernel-modules
NVIDIA_KERNEL_OPEN ?= $(NVIDIA_OPEN_ROOT)/kernel-open

# nv-p2p.h:
#   $(NVIDIA_KERNEL_OPEN)/nvidia/nv-p2p.h
NV_P2P_HEADER_PATH ?= $(NVIDIA_KERNEL_OPEN)/nvidia

# Module.symvers generated by the same open NVIDIA driver build
NV_MODULE_SYMVERS ?= $(NVIDIA_KERNEL_OPEN)/Module.symvers

.PHONY: all clean show-vars

all:
	@test -f "$(NV_P2P_HEADER_PATH)/nv-p2p.h" || { \
		echo "missing nv-p2p.h: $(NV_P2P_HEADER_PATH)/nv-p2p.h"; \
		exit 1; \
	}
	@test -f "$(NV_MODULE_SYMVERS)" || { \
		echo "missing Module.symvers: $(NV_MODULE_SYMVERS)"; \
		exit 1; \
	}
	$(MAKE) -C $(KDIR) M=$(CURDIR) \
		CONFIG_UB=m \
		CONFIG_UB_UBASE=m \
		CONFIG_UB_URMA=m \
		CONFIG_UB_UDMA=m \
		NV_P2P_HEADER_PATH=$(NV_P2P_HEADER_PATH) \
		KBUILD_EXTRA_SYMBOLS=$(abspath $(NV_MODULE_SYMVERS)) \
		modules

show-vars:
	@echo KDIR=$(KDIR)
	@echo NVIDIA_OPEN_ROOT=$(NVIDIA_OPEN_ROOT)
	@echo NVIDIA_KERNEL_OPEN=$(NVIDIA_KERNEL_OPEN)
	@echo NV_P2P_HEADER_PATH=$(NV_P2P_HEADER_PATH)
	@echo NV_MODULE_SYMVERS=$(NV_MODULE_SYMVERS)

clean:
	$(MAKE) -C $(KDIR) M=$(CURDIR) clean

else

# These values are normally passed by the outer Make invocation.
# Keep defaults so direct Kbuild invocation also works.
NVIDIA_OPEN_ROOT ?= /home/tong/project_4090/open-gpu-kernel-modules
NVIDIA_KERNEL_OPEN ?= $(NVIDIA_OPEN_ROOT)/kernel-open

NV_P2P_HEADER_PATH ?= $(NVIDIA_KERNEL_OPEN)/nvidia
NV_MODULE_SYMVERS ?= $(NVIDIA_KERNEL_OPEN)/Module.symvers

ccflags-y += -I$(NV_P2P_HEADER_PATH)

ifeq ($(KBUILD_EXTRA_SYMBOLS),)
KBUILD_EXTRA_SYMBOLS := $(NV_MODULE_SYMVERS)
endif

obj-y += ubus/
obj-y += ubfi/
obj-y += obmm/
obj-$(CONFIG_UB_UBASE) += ubase/
obj-$(CONFIG_UB_CDMA) += cdma/
obj-$(CONFIG_UB_URMA) += urma/
obj-$(CONFIG_UB_UDMA) += urma/hw/udma/
obj-$(CONFIG_UB_SENTRY) += sentry/
obj-$(CONFIG_UB_UBDEVSHM) += ubdevshm/
obj-$(CONFIG_UB_UBMEMPFD) += ubmempfd/

endif
